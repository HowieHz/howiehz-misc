{
  "name": "docs",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vitepress build .",
    "preview": "pnpm run build && vitepress preview .",
    "test": "pnpm --filter graphwar-killer-wasm build && pnpm --filter osu-beatmap-converter build && pnpm run test:unit",
    "test:unit": "vitest run tools/graphwar-killer tools/osu-beatmap-converter",
    "watch": "vitepress dev ."
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "@lucide/vue": "^1.39.0",
    "compat-finder": "workspace:*",
    "graphwar-killer-wasm": "workspace:*",
    "lunar-javascript": "^1.7.7",
    "osu-beatmap-converter": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@mdit/plugin-footnote": "^1.0.2",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.18.2",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.13.2",
    "lightningcss": "^1.33.0",
    "markdown-it-mathjax3": "^4.3.2",
    "pagefind": "^1.5.2",
    "vite": "^8.2.2",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-pagefind": "^0.4.24",
    "vitepress-plugin-rss": "^0.4.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
