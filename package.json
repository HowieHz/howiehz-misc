{
  "name": "howiehz-misc",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Misc Site: For things that don't belong on the main site.",
  "keywords": [
    "HowieHz"
  ],
  "homepage": "https://howiehz.top/misc",
  "bugs": {
    "url": "https://github.com/HowieHz/howiehz-misc/issues"
  },
  "license": "MIT",
  "author": "HowieHz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowieHz/howiehz-misc.git"
  },
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "docs:build": "pnpm --filter 'docs...' build",
    "docs:preview": "pnpm --filter 'docs^...' build && pnpm --filter docs preview",
    "docs:watch": "pnpm --filter 'docs^...' build && pnpm --parallel --stream --filter 'docs...' watch",
    "fmt": "pnpm run '/^fmt:/'",
    "fmt:java": "node scripts/format-java.js",
    "fmt:oxfmt": "oxfmt --threads 3 '**/*.{json,jsonc,yaml,md,css,js,mjs,ts,vue,html}'",
    "lint": "pnpm --filter 'docs^...' build && pnpm run '/^lint:/'",
    "lint:autocorrect": "autocorrect --fix",
    "lint:md": "markdownlint --fix '**/*.md' --ignore-path .gitignore",
    "lint:oxlint+eslint": "oxlint --type-aware --report-unused-disable-directives --fix && eslint --fix",
    "lint:style": "stylelint --fix '**/*.{css,vue}' 'docs/.vitepress/**/*.{css,vue}' --ignore-path .gitignore",
    "lint:type-check": "vue-tsc -b packages/compat-finder/tsconfig.json && vue-tsc -b docs/tsconfig.json && vue-tsc -b packages/blogsclub-signin-helper/tsconfig.json",
    "migrate:oxlint": "pnpm dlx @oxlint/migrate --type-aware --with-nursery && pnpm oxfmt -- --write .oxlintrc.json",
    "preinstall": "npx only-allow pnpm",
    "test": "node scripts/test-all.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autocorrect-node": "^2.14.0",
    "browserslist": "^4.28.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "^1.80.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "browserslist": [
    "defaults",
    "Safari >= 16.4",
    "Chrome >= 111",
    "Firefox >= 128"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": "^11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
